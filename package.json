{
  "name": "founder-hq",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "supabase:github-fake": "node scripts/supabase-github.mjs fake",
    "supabase:github-real": "node scripts/supabase-github.mjs real",
    "secrets": "git ls-files -z --cached --others --exclude-standard | xargs -0 secretlint --secretlintignore .secretlintignore --maskSecrets",
    "audit": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=high",
    "check:build-secrets": "node scripts/check-build-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run secrets && npm run audit && npm run build:canary && npm run check:build-secrets && npm run test:e2e",
    "build:canary": "SUPABASE_SERVICE_ROLE_KEY=canary-service-role-key-7f3a9c next build",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "secretlint": "13.0.7",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
