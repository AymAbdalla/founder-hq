# Copy to .env.local and fill in. Never commit real values.
# Public settings (safe in browser code). Never put a secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Read only in src/lib/supabase/admin.ts (enforced by lint).
SUPABASE_SERVICE_ROLE_KEY=

# Phone notifications (plan slice 3). Generate the key pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is the site's https address or a mailto: address you read.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Shared secret the database's every-minute job sends to /api/notify. At least 32 characters.
CRON_SECRET=
